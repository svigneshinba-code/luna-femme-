PORT=4000
# Comma-separated list of allowed frontend origins (add your LAN IP:5500 to test from a phone)
CLIENT_ORIGIN=http://localhost:5500
JWT_SECRET=change-this-to-a-long-random-string

# Razorpay test-mode keys, from Dashboard > Settings > API Keys.
# Leave the placeholders as-is to keep online payment disabled (COD still works).
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
